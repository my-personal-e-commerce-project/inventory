CREATE TABLE coupon (
    id VARCHAR(255) PRIMARY KEY UNIQUE NOT NULL,
    name VARCHAR(255) NOT NULL,
    discountType VARCHAR(255) NOT NULL,
    decrementValue DOUBLE PRECISION NOT NULL,
    percentageValue DOUBLE PRECISION NOT NULL,

    validAllCategories BOOLEAN DEFAULT NULL,

    minPrice DOUBLE PRECISION NOT NULL,
    maxPrice DOUBLE PRECISION NOT NULL,
    minStock int NOT NULL,
    maxStock int NOT NULL,

    autoApply BOOLEAN DEFAULT NULL,
    expiredAt timestamp DEFAULT now()
);

CREATE TABLE coupon_categories (
    coupon_id VARCHAR(255) NOT NULL,
    category_id VARCHAR(255) NOT NULL,
    PRIMARY KEY (coupon_id, category_id),
    CONSTRAINT fk_product FOREIGN KEY (coupon_id) REFERENCES coupons (id) ON DELETE CASCADE,
    CONSTRAINT fk_category FOREIGN KEY (category_id) REFERENCES Category (id) ON DELETE CASCADE
);
